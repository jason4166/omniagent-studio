{
  "openapi": "3.1.0",
  "info": {
    "title": "OmniAgent local mock tools",
    "version": "1.0.0"
  },
  "paths": {
    "/tools/lookup_product": {
      "get": {
        "operationId": "lookup_product",
        "responses": {
          "200": {
            "description": "Synthetic business result"
          }
        },
        "parameters": [
          {
            "name": "sku",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        ]
      }
    },
    "/tools/check_warranty": {
      "get": {
        "operationId": "check_warranty",
        "responses": {
          "200": {
            "description": "Synthetic business result"
          }
        },
        "parameters": [
          {
            "name": "serial_number",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        ]
      }
    },
    "/tools/lookup_customer": {
      "get": {
        "operationId": "lookup_customer",
        "responses": {
          "200": {
            "description": "Synthetic business result"
          }
        },
        "parameters": [
          {
            "name": "customer_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        ]
      }
    },
    "/tools/create_followup": {
      "post": {
        "operationId": "create_followup",
        "responses": {
          "200": {
            "description": "Synthetic business result"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                },
                "required": [
                  "customer_id",
                  "note"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/tools/request_discount": {
      "post": {
        "operationId": "request_discount",
        "responses": {
          "200": {
            "description": "Synthetic business result"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "percent": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                },
                "required": [
                  "customer_id",
                  "percent",
                  "reason"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  }
}
